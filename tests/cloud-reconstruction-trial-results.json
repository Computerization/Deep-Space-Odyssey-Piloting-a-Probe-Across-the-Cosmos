  "helper": " vec4 sampleCloud(vec2 uv,vec3 origin,vec3 direction){\n  vec2 size=vec2(textureSize(cloudColor,0)),p=uv*size-.5,base=floor(p),f=p-base;\n  float along=dot(origin,direction),hit=along*along-dot(origin,origin)+1.00143*1.00143;\n  float edge=hit/max(fwidth(hit)*max(viewport.x/size.x,viewport.y/size.y),.00000001);\n  vec4 linear=texture2D(cloudColor,uv);\n  if(edge<=2.||all(equal(size,viewport)))return linear;\n  vec2 w0=f*(-.5+f*(1.-.5*f));\n  vec2 w1=1.+f*f*(-2.5+1.5*f);\n  vec2 w2=f*(.5+f*(2.-1.5*f));\n  vec2 w3=f*f*(-.5+.5*f),middle=w1+w2;\n  vec3 x=vec3(base.x-.5,base.x+.5+w2.x/middle.x,base.x+2.5)/size.x;\n  vec3 y=vec3(base.y-.5,base.y+.5+w2.y/middle.y,base.y+2.5)/size.y;\n  vec3 wx=vec3(w0.x,middle.x,w3.x),wy=vec3(w0.y,middle.y,w3.y);\n  vec4 result=vec4(0.);\n  for(int j=0;j<3;j++)for(int i=0;i<3;i++)result+=texture2D(cloudColor,vec2(x[i],y[j]))*wx[i]*wy[j];\n  vec4 a=texelFetch(cloudColor,clamp(ivec2(base),ivec2(0),ivec2(size)-1),0);\n  vec4 b=texelFetch(cloudColor,clamp(ivec2(base)+ivec2(1,0),ivec2(0),ivec2(size)-1),0);\n  vec4 c=texelFetch(cloudColor,clamp(ivec2(base)+ivec2(0,1),ivec2(0),ivec2(size)-1),0);\n  vec4 d=texelFetch(cloudColor,clamp(ivec2(base)+ivec2(1,1),ivec2(0),ivec2(size)-1),0);\n  return mix(linear,clamp(result,min(min(a,b),min(c,d)),max(max(a,b),max(c,d))),smoothstep(2.,4.,edge));\n }\n",
